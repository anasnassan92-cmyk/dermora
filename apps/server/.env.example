# ---- Dermora server (Hostinger Node.js Web App) ----
# On Hostinger: set these in hPanel → Websites → <site> → Environment variables → Apply changes.
# Locally: copy to .env (never commit .env). Leave DB_HOST empty to use a local SQLite file.

# Database (hPanel → Databases → MySQL). The password is pasted by the owner, never in chat.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Admins: users who register with these e-mails get access to /admin (comma separated)
ADMIN_EMAILS=

# AI (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Photo quality check (Google Cloud → Cloud Vision API → Credentials → API key)
GOOGLE_VISION_API_KEY=

# Google sign-in (Google Cloud → Credentials → OAuth client ID → Web). Public value.
GOOGLE_CLIENT_ID=

# E-mail for the 6-digit codes (Hostinger mailbox). Without SMTP the code is shown on screen (demo).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: where uploads and the auto-generated signing secret live (default: $HOME/dermora-data)
DATA_DIR=

# Google-inloggning i Android-appen (APK): OAuth-klient av typen Android (paket se.dermora.app + SHA-1 från EAS)
GOOGLE_ANDROID_CLIENT_ID=
# Fler accepterade klient-id:n (kommaseparerat), t.ex. iOS
GOOGLE_CLIENT_IDS=
# Chatbot-modeller (valfritt)
GEMINI_ANALYSIS_MODEL=gemini-flash-latest   # gemini-2.5-pro om nyckeln har tillgång (404 annars)
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_ANALYSIS_THINKING=512   # större budget = bättre analys men långsammare; Hostinger bryter efter ~55 s
GEMINI_CHAT_THINKING=0
