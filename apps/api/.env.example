# ---- Dermora API ----
# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | production
DEV_AUTH=true                  # true = accept "Bearer dev:<user-id>" tokens (local only!)
CORS_ORIGINS=http://localhost:8085,http://localhost:19006,exp://localhost:8081

# Supabase (Settings -> API). Leave empty to run fully in-memory (mock repositories).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=skin-images

# AI provider: mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
