# ---- Dermora API ----
# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # development | production
DEV_AUTH=true                  # true = accept "Bearer dev:<user-id>" tokens (local only!)
CORS_ORIGINS=http://localhost:8085,http://localhost:8081

# Supabase (Settings -> API). Leave empty to run fully in-memory (mock repositories).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=skin-images

# AI provider for analysis + chat: mock | gemini | anthropic
AI_PROVIDER=mock
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Face detection for photo quality: opencv (local, default) | google (Cloud Vision API)
# Google: enable "Cloud Vision API" in a Google Cloud project, create an API key restricted to it.
FACE_DETECTOR=opencv
GOOGLE_VISION_API_KEY=
